rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function valid(uid, id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['name','role','company','phone','email','address','website','notes','rawText','imagePath','originalPath','favorite','createdAt','status','uploadStartedAt','backImagePath','backOriginalPath','backRawText','sourceScanId'])
        && d.keys().hasAll(['name','role','company','phone','email','address','website','notes','rawText','imagePath','originalPath','favorite','createdAt','status'])
        && d.get('sourceScanId','') is string && d.get('sourceScanId','').size() <= 36
        && d.name is string && d.name.size() <= 200
        && d.role is string && d.role.size() <= 300
        && d.company is string && d.company.size() <= 300
        && (d.name.size() > 0 || d.company.size() > 0)
        && d.phone is string && d.phone.size() <= 100
        && d.email is string && d.email.size() <= 300
        && d.address is string && d.address.size() <= 1000
        && d.website is string && d.website.size() <= 300
        && d.notes is string && d.notes.size() <= 4000
        && d.rawText is string && d.rawText.size() <= 12000
        && d.get('backRawText','') is string && d.get('backRawText','').size() <= 12000
        && ((d.get('backImagePath','') == '' && d.get('backOriginalPath','') == '') || (d.get('backImagePath','') == 'users/' + uid + '/cards/' + id + '/back-preview.jpg' && d.get('backOriginalPath','') == 'users/' + uid + '/cards/' + id + '/back-original'))
        && d.favorite is bool && d.createdAt is int && d.createdAt > 0
        && d.createdAt <= request.time.toMillis() + 300000
        && d.status in ['uploading','ready','deleting']
        && (!('uploadStartedAt' in d) || (d.uploadStartedAt is int && d.uploadStartedAt > 0 && d.uploadStartedAt <= request.time.toMillis() + 300000))
        && ((d.imagePath == '' && d.originalPath == '') ||
          (d.imagePath == 'users/' + uid + '/cards/' + id + '/preview.jpg'
          && d.originalPath == 'users/' + uid + '/cards/' + id + '/original'));
    }
    match /users/{uid}/cards/{id} {
      allow read: if owner(uid);
      allow create: if owner(uid) && valid(uid, id) && request.resource.data.status in ['uploading','ready'];
      allow update: if owner(uid) && valid(uid, id)
        && (resource.data.status != 'deleting' || request.resource.data.status == 'deleting')
        && (resource.data.status != 'ready' || request.resource.data.status != 'uploading')
        && request.resource.data.get('sourceScanId','') == resource.data.get('sourceScanId','')
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.imagePath == resource.data.imagePath
        && request.resource.data.originalPath == resource.data.originalPath
        && request.resource.data.get('backImagePath','') == resource.data.get('backImagePath','')
        && request.resource.data.get('backOriginalPath','') == resource.data.get('backOriginalPath','');
      allow delete: if owner(uid) && resource.data.status == 'deleting';
    }
  }
}
