rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function text(value, limit) { return value is string && value.size() <= limit; }
    function validPhone(p) {
      return p.keys().hasOnly(['number','label'])
        && p.number.matches('(?s).{1,80}') && p.label.matches('(?s).{0,40}');
    }
    function validPhones(values) {
      let count = values.size();
      return values is list && count <= 12
        && (count < 1 || validPhone(values[0])) && (count < 2 || validPhone(values[1]))
        && (count < 3 || validPhone(values[2])) && (count < 4 || validPhone(values[3]))
        && (count < 5 || validPhone(values[4])) && (count < 6 || validPhone(values[5]))
        && (count < 7 || validPhone(values[6])) && (count < 8 || validPhone(values[7]))
        && (count < 9 || validPhone(values[8])) && (count < 10 || validPhone(values[9]))
        && (count < 11 || validPhone(values[10])) && (count < 12 || validPhone(values[11]));
    }
    function valid(uid, id) {
      let d = request.resource.data;
      let phones = d.get('phones', []);
      let prefix = 'users/' + uid + '/cards/' + id + '/';
      return d.keys().hasOnly(['name','role','company','phone','phones','email','address','website','notes','rawText','imagePath','originalPath','favorite','createdAt','status','uploadStartedAt','backImagePath','backOriginalPath','backRawText','sourceScanId','previousRecord'])
        && d.keys().hasAll(['name','role','company','phone','email','address','website','notes','rawText','imagePath','originalPath','favorite','createdAt','status'])
        && text(d.get('sourceScanId',''),36)
        && text(d.name,200)
        && text(d.role,300)
        && text(d.company,300)
        && (d.name.size() > 0 || d.company.size() > 0)
        && text(d.phone,100)
        && validPhones(phones)
        && text(d.email,300)
        && text(d.address,1000)
        && text(d.website,300)
        && text(d.notes,4000)
        && text(d.rawText,12000)
        && text(d.get('backRawText',''),12000)
        && ((d.get('backImagePath','') == '' && d.get('backOriginalPath','') == '') || (d.get('backImagePath','').matches(prefix + 'back-preview(-r[a-f0-9]{32})?[.]jpg') && d.get('backOriginalPath','').matches(prefix + 'back-original(-r[a-f0-9]{32})?')))
        && d.favorite is bool && d.createdAt is int && d.createdAt > 0
        && d.createdAt <= request.time.toMillis() + 300000
        && d.status in ['uploading','ready','deleting','rollingBack']
        && (!('uploadStartedAt' in d) || (d.uploadStartedAt is int && d.uploadStartedAt > 0 && d.uploadStartedAt <= request.time.toMillis() + 300000))
        && ((d.imagePath == '' && d.originalPath == '') ||
          (d.imagePath.matches(prefix + 'preview(-r[a-f0-9]{32})?[.]jpg')
          && d.originalPath.matches(prefix + 'original(-r[a-f0-9]{32})?')));
    }
    match /users/{uid}/cards/{id} {
      allow read: if owner(uid);
      allow create: if owner(uid) && valid(uid, id) && !('previousRecord' in request.resource.data) && request.resource.data.status in ['uploading','ready'];
      allow update: if owner(uid) && valid(uid, id)
        && (resource.data.status != 'deleting' || request.resource.data.status == 'deleting')
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          (resource.data.status == 'ready' && request.resource.data.status == 'uploading'
            && !('previousRecord' in resource.data)
            && request.resource.data.get('previousRecord', {}) == resource.data
            && request.resource.data.get('sourceScanId','') != resource.data.get('sourceScanId',''))
          || (resource.data.status == 'rollingBack' && request.resource.data == resource.data.get('previousRecord', {}))
          || ((resource.data.status != 'ready' || request.resource.data.status != 'uploading')
        && (resource.data.status != 'rollingBack' || request.resource.data.status in ['rollingBack','deleting'])
        && (request.resource.data.status != 'rollingBack' || resource.data.status in ['uploading','rollingBack'])
        && request.resource.data.get('sourceScanId','') == resource.data.get('sourceScanId','')
        && (!('previousRecord' in request.resource.data) || request.resource.data.previousRecord == resource.data.get('previousRecord', {}))
        && request.resource.data.imagePath == resource.data.imagePath
        && request.resource.data.originalPath == resource.data.originalPath
        && request.resource.data.get('backImagePath','') == resource.data.get('backImagePath','')
        && request.resource.data.get('backOriginalPath','') == resource.data.get('backOriginalPath','')));
      allow delete: if owner(uid) && resource.data.status == 'deleting';
    }
  }
}
