rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function text(value, limit) { return value is string && value.size() <= limit; }
    function validPhone(p) {
      return p.size() == 2
        && p.number.matches('(?s).{1,80}') && p.label.matches('(?s).{0,40}');
    }
    function validPhones(values) {
      let count=values.size();
      return values is list && count <= 12 && (count == 12 ? (validPhone(values[0]) && validPhone(values[1]) && validPhone(values[2]) && validPhone(values[3]) && validPhone(values[4]) && validPhone(values[5]) && validPhone(values[6]) && validPhone(values[7]) && validPhone(values[8]) && validPhone(values[9]) && validPhone(values[10]) && validPhone(values[11])) : ((count < 1 || validPhone(values[0])) && (count < 2 || validPhone(values[1]))
        && (count < 3 || validPhone(values[2])) && (count < 4 || validPhone(values[3]))
        && (count < 5 || validPhone(values[4])) && (count < 6 || validPhone(values[5]))
        && (count < 7 || validPhone(values[6])) && (count < 8 || validPhone(values[7]))
        && (count < 9 || validPhone(values[8])) && (count < 10 || validPhone(values[9]))
        && (count < 11 || validPhone(values[10])) && (count < 12 || validPhone(values[11]))));
    }
    function validStrings(values, pattern, maximum) {
      let count = values.size();
      return values is list && count <= maximum
        && (count == 0 || (values == values.join('\n').split('\n') && values.join('\n').matches(pattern)))
        ;
    }
    // Timestamp-prefixed note keys keep validation bounded without dropping per-note checks.
    function validNotes(notes) {
      let values=notes.values();
      let joined=values.join('\u001f');
      return notes is map && validStrings(notes.keys(),'([1-9][0-9]{0,17}|9223372036854775807|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]):[^\n]{1,100}(\n([1-9][0-9]{0,17}|9223372036854775807|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]):[^\n]{1,100})*',24)
        && (notes.size() == 0 || (values == joined.split('\u001f') && joined.matches('[^\\x1f]{1,1000}[^\\x1f]{0,1000}[^\\x1f]{0,1000}[^\\x1f]{0,1000}(\\x1f[^\\x1f]{1,1000}[^\\x1f]{0,1000}[^\\x1f]{0,1000}[^\\x1f]{0,1000})*')));
    }
    function validMetadata(d) { return validStrings(d.get('emails',[]),'[^\n]{0,300}(\n[^\n]{0,300})*',12) && validStrings(d.get('websites',[]),'[^\n]{0,300}(\n[^\n]{0,300})*',12)
        && validStrings(d.get('tags',[]),'[^\n]{0,80}(\n[^\n]{0,80})*',24) && validStrings(d.get('collections',[]),'[^\n]{0,80}(\n[^\n]{0,80})*',24)
        && d.get('transliteratedName','').matches('(?s).{0,200}')
        && d.get('meetingDate','').matches('(?s).{0,10}') && d.get('event','').matches('(?s).{0,300}') && d.get('location','').matches('(?s).{0,500}')
        && validNotes(d.get('datedNotes',{})) && d.get('isOwnCard',false) is bool
        && d.get('revision',0) is int && d.get('revision',0) >= 0
        && d.get('updatedAt',0) is int && d.get('updatedAt',0) >= 0 && d.get('updatedAt',0) <= request.time.toMillis() + 300000
        && d.get('deletedAt',0) is int && d.get('deletedAt',0) >= 0 && d.get('deletedAt',0) <= request.time.toMillis() + 300000; }
    function valid(uid, id) {
      let d = request.resource.data;
      let phones = d.get('phones', []);
      let prefix = 'users/' + uid + '/cards/' + id + '/';
      return d.keys().hasOnly(['name','role','company','phone','phones','email','address','website','notes','rawText','imagePath','originalPath','favorite','createdAt','status','uploadStartedAt','backImagePath','backOriginalPath','backRawText','sourceScanId','previousRecord','emails','websites','tags','collections','meetingDate','event','location','datedNotes','isOwnCard','updatedAt','revision','deletedAt','mutationId','transliteratedName'])
        && d.keys().hasAll(['name','role','company','phone','email','address','website','notes','rawText','imagePath','originalPath','favorite','createdAt','status'])
        && d.get('sourceScanId','').matches('(?s).{0,36}')
        && d.get('mutationId','').matches('(?s).{0,100}')
        && (!d.keys().hasAny(['emails','websites','tags','collections','transliteratedName','meetingDate','event','location','datedNotes','isOwnCard','revision','updatedAt','deletedAt']) || validMetadata(d))
        && d.name.matches('(?s).{0,200}')
        && d.role.matches('(?s).{0,300}')
        && d.company.matches('(?s).{0,300}')
        && (d.name.size() > 0 || d.company.size() > 0)
        && d.phone.matches('(?s).{0,100}')
        && validPhones(phones)
        && d.email.matches('(?s).{0,300}')
        && d.address.matches('(?s).{0,1000}')
        && d.website.matches('(?s).{0,300}')
        && text(d.notes,4000)
        && text(d.rawText,12000)
        && text(d.get('backRawText',''),12000)
        && ((d.get('backImagePath','') == '' && d.get('backOriginalPath','') == '') || (d.get('backImagePath','').matches(prefix + 'back-preview(-r[a-f0-9]{32})?[.]jpg') && d.get('backOriginalPath','').matches(prefix + 'back-original(-r[a-f0-9]{32})?')))
        && d.favorite is bool && d.createdAt is int && d.createdAt > 0
        && d.createdAt <= request.time.toMillis() + 300000
        && d.status in ['uploading','ready','deleting','rollingBack']
        && (!('uploadStartedAt' in d) || (d.uploadStartedAt is int && d.uploadStartedAt > 0 && d.uploadStartedAt <= request.time.toMillis() + 300000))
        && ((d.imagePath == '' && d.originalPath == '') ||
          (d.imagePath.matches(prefix + 'preview(-r[a-f0-9]{32})?[.]jpg')
          && d.originalPath.matches(prefix + 'original(-r[a-f0-9]{32})?')));
    }
    match /users/{uid}/cards/{id} {
      function revisionProgresses() {
        return (resource.data.get('revision',0) == 0 && request.resource.data.get('revision',0) == 0)
          || request.resource.data.get('revision',0) == resource.data.get('revision',0) + 1
          || (request.resource.data.get('revision',0) == resource.data.get('revision',0)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','uploadStartedAt','previousRecord']))
          || (resource.data.status == 'rollingBack' && request.resource.data == resource.data.get('previousRecord',{}));
      }
      allow read: if owner(uid);
      allow create: if owner(uid) && valid(uid, id) && request.resource.data.get('revision',0) in [0,1] && !('previousRecord' in request.resource.data) && request.resource.data.status in ['uploading','ready'];
      allow update: if owner(uid) && valid(uid, id)
        && revisionProgresses()
        && (resource.data.status != 'deleting' || request.resource.data.status == 'deleting')
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          (resource.data.status == 'ready' && request.resource.data.status == 'uploading'
            && !('previousRecord' in resource.data)
            && request.resource.data.get('previousRecord', {}) == resource.data
            && request.resource.data.get('sourceScanId','') != resource.data.get('sourceScanId',''))
          || (resource.data.status == 'rollingBack' && request.resource.data == resource.data.get('previousRecord', {}))
          || ((resource.data.status != 'ready' || request.resource.data.status != 'uploading')
        && (resource.data.status != 'rollingBack' || request.resource.data.status in ['rollingBack','deleting'])
        && (request.resource.data.status != 'rollingBack' || resource.data.status in ['uploading','rollingBack'])
        && request.resource.data.get('sourceScanId','') == resource.data.get('sourceScanId','')
        && (!('previousRecord' in request.resource.data) || request.resource.data.previousRecord == resource.data.get('previousRecord', {}))
        && request.resource.data.imagePath == resource.data.imagePath
        && request.resource.data.originalPath == resource.data.originalPath
        && request.resource.data.get('backImagePath','') == resource.data.get('backImagePath','')
        && request.resource.data.get('backOriginalPath','') == resource.data.get('backOriginalPath','')));
      allow delete: if owner(uid) && resource.data.status == 'deleting';
    }
  }
}
