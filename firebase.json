{
  "firestore": {
    "rules": "firestore.rules",
    "location": "asia-south1",
    "database": "(default)",
    "edition": "standard"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 18080
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "auth": {
    "providers": {
      "emailPassword": true
    }
  },
  "hosting": {
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          },
          {
            "key": "Cache-Control",
            "value": "no-store"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src https://identitytoolkit.googleapis.com https://securetoken.googleapis.com; img-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "destination": "/index.html",
        "source": "/auth"
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "public": "backend/auth/public"
  }
}
